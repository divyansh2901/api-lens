# PostgreSQL database used by Prisma. Create the database before running migrations.
DATABASE_URL="postgresql://postgres:password@localhost:5432/api_lens?schema=public"

# Use a long, random value in real environments (at least 32 characters).
JWT_SECRET="replace-this-with-a-random-secret-at-least-32-characters-long"

# Optional; defaults to 5000.
PORT=5000
